# HCS credentials (console → My Credentials → Access Keys)
HCS_AK=your-ak
HCS_SK=your-sk
HCS_PROJECT_ID=your-project-id
HCS_ENDPOINT=https://vpc.your-hcs-region.example

# Rate budget: shared cloud quota is 90/5min; our slice defaults to 25
SERVICE_CALL_BUDGET=25

# TLS: point CA_BUNDLE at the internal root CA (preferred), or set
# SSL_VERIFY=false for dev
CA_BUNDLE=
SSL_VERIFY=true
