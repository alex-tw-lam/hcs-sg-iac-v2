{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcs-sg.local/schemas/rules-file.schema.json",
  "title": "hcs-sg rules file",
  "$comment": "rules/<name>.yaml \u2014 the file's name stem must equal `security_group`, which must have a groups/<name>.yaml; remote group references must point at existing groups (cross-file, validated at load/plan time).",
  "type": "object",
  "required": [
    "security_group"
  ],
  "properties": {
    "security_group": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "ingress": {
      "type": "array",
      "description": "absent key = direction unmanaged (never touched); [] = remove all rules in this direction",
      "items": {
        "type": "object",
        "required": [
          "source",
          "protocol"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "group name, or IPv4 CIDR (bare IP auto-/32); IPv6 is not supported"
          },
          "protocol": {
            "enum": [
              "tcp",
              "udp",
              "icmp",
              "icmpv6",
              "all"
            ]
          },
          "ports": {
            "description": "port spec: \"80\", \"22,443\", \"8000-9000\" (mixed ok, max 20 entries after merge); bare integer or list of integers accepted; absent/empty = all ports",
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$"
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "protocol": {
                  "enum": [
                    "icmp",
                    "icmpv6",
                    "all"
                  ]
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "not": {
                    "required": [
                      "ports"
                    ]
                  }
                },
                {
                  "properties": {
                    "ports": {
                      "enum": [
                        "",
                        []
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "egress": {
      "type": "array",
      "description": "absent key = direction unmanaged (never touched); [] = remove all rules in this direction",
      "items": {
        "type": "object",
        "required": [
          "destination",
          "protocol"
        ],
        "properties": {
          "destination": {
            "type": "string",
            "description": "group name, or IPv4 CIDR (bare IP auto-/32); IPv6 is not supported"
          },
          "protocol": {
            "enum": [
              "tcp",
              "udp",
              "icmp",
              "icmpv6",
              "all"
            ]
          },
          "ports": {
            "description": "port spec: \"80\", \"22,443\", \"8000-9000\" (mixed ok, max 20 entries after merge); bare integer or list of integers accepted; absent/empty = all ports",
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$"
              },
              {
                "type": "string",
                "enum": [
                  ""
                ]
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "protocol": {
                  "enum": [
                    "icmp",
                    "icmpv6",
                    "all"
                  ]
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "not": {
                    "required": [
                      "ports"
                    ]
                  }
                },
                {
                  "properties": {
                    "ports": {
                      "enum": [
                        "",
                        []
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
