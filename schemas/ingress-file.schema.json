{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcs-sg.local/schemas/ingress-file.schema.json",
  "title": "hcs-sg ingress rules file",
  "$comment": "security-groups/<name>/ingress.yaml \u2014 a bare list; an ABSENT file = the direction is unmanaged, [] = remove all rules in it; the sibling group.yaml must exist with the same directory name; remote group references must point at existing groups (cross-file, validated at load/plan time).",
  "type": "array",
  "description": "absent key = direction unmanaged (never touched); [] = remove all rules in this direction",
  "items": {
    "type": "object",
    "required": [
      "source",
      "protocol"
    ],
    "properties": {
      "source": {
        "type": "string",
        "description": "group name, or IPv4 CIDR (bare IP auto-/32); IPv6 is not supported"
      },
      "protocol": {
        "enum": [
          "tcp",
          "udp",
          "icmp",
          "icmpv6",
          "all"
        ]
      },
      "ports": {
        "description": "port spec: \"80\", \"22,443\", \"8000-9000\" (mixed ok, max 20 entries after merge); bare integer or list of integers accepted; absent/empty = all ports",
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$"
          },
          {
            "type": "string",
            "enum": [
              ""
            ]
          },
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "protocol": {
              "enum": [
                "icmp",
                "icmpv6",
                "all"
              ]
            }
          }
        },
        "then": {
          "anyOf": [
            {
              "not": {
                "required": [
                  "ports"
                ]
              }
            },
            {
              "properties": {
                "ports": {
                  "enum": [
                    "",
                    []
                  ]
                }
              }
            }
          ]
        }
      }
    ]
  }
}
